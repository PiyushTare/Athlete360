<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Health Connect Permissions &amp; Privacy"
            android:textColor="@color/text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Athlete 360 uses Android Health Connect to read genuine health telemetry recorded by your Fastrack smartwatch (via Fastrack Smart / Google Fit)."
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:lineSpacingExtra="3dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Data We Read:"
            android:textColor="@color/cyan_400"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• Heart Rate: Resting &amp; workout pulse for cardiovascular recovery modeling.\n• Blood Oxygen (SpO2): Arterial saturation for altitude &amp; fatigue tracking.\n• Steps &amp; Distance: Daily locomotion volume.\n• Active Calories: Energy expenditure for metabolic readiness calculation.\n• Sleep Sessions: Total duration and sleep stages to calculate CNS fatigue scores."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Privacy Guarantee:"
            android:textColor="@color/emerald_400"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="• All health records are transmitted solely to your authenticated Athlete 360 dashboard over secure connections.\n• We NEVER share your health data with advertisers, third parties, or data brokers.\n• You can revoke permissions anytime through Android System Settings &gt; Security &amp; Privacy &gt; Health Connect."
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:lineSpacingExtra="4dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCloseRationale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="30dp"
            android:backgroundTint="@color/cyan_500"
            android:text="Return to Companion App"
            android:textColor="@color/bg_dark"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
